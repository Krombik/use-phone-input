{
  "name": "use-phone-input",
  "version": "2.0.3",
  "description": "Simplify phone number handling in React applications with automatic formatting, validation, and country code selection for international numbers",
  "author": "Krombik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krombik/use-phone-input.git"
  },
  "bugs": {
    "url": "https://github.com/Krombik/use-phone-input/issues"
  },
  "homepage": "https://github.com/Krombik/use-phone-input#readme",
  "type": "module",
  "source": "src/index.ts",
  "imports": {
    "#src/constants": "./src/constants.ts",
    "#src/types/*": "./src/types/*.ts",
    "#src/*": "./src/*/index.ts"
  },
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@types/react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  },
  "keywords": [
    "react",
    "tel",
    "phone",
    "number",
    "input",
    "telephone",
    "international"
  ],
  "sideEffects": false
}
